{
  "name": "image-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --persist-to ../../.wrangler/state",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "mcp-inspect": "npx @modelcontextprotocol/inspector@latest",
    "test": "node --experimental-strip-types --test test/frame-sampling.test.mjs && npm run test:mcp",
    "test:mcp": "wrangler deploy --dry-run --outdir .test-build && node --test test/mcp-http.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@sight-cache/db": "*",
    "@sight-cache/worker-home-page": "*",
    "agents": "^0.23.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "typescript": "^7.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
