{
  "name": "admin-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "dev:migrate": "npx wrangler d1 migrations apply DB --local",
    "prod:migrate": "npx wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
